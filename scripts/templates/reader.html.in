<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>{{TITLE}}</title><meta name="description" content="{{DESCRIPTION}}"><link rel="canonical" href="{{CANONICAL}}">{{SOCIAL}}{{SITE_DATA}}<link rel="icon" href="{{PREFIX}}icons/icon.svg"><script src="{{PREFIX}}education/computing/assets/theme.js"></script><script src="{{PREFIX}}navigation.js"></script><link rel="stylesheet" href="{{PREFIX}}styles.css"><script defer src="{{PREFIX}}script.js"></script>{{MATHJAX}}</head>
<body class="{{BODY_CLASS}}"><a class="skip-link" href="#main">Skip to content</a>
<aside class="sidebar" id="contents">{{LOGO}}<label class="search-label" for="topic-search">Search topics</label><input id="topic-search" type="search" placeholder="Search topics…" autocomplete="off"><p id="search-status" role="status" class="search-status"></p><nav aria-label="Table of contents"><a class="intro-link" {{INTRO_CURRENT}} href="{{PREFIX}}{{INTRO_TARGET}}">{{INTRO_LABEL}}</a>{{SIDEBAR}}<a class="intro-link" href="{{PREFIX}}references/index.html">Bibliography</a></nav><a class="sidebar-contact" href="mailto:{{EMAIL}}">Contact the editors ↗</a></aside>
{{OUTER_BODY}}<header class="toolbar"><button id="menu-toggle" type="button" aria-controls="contents" aria-expanded="false" hidden>☰ <span>Contents</span></button>{{TOOLBAR_LINK}}{{NAVIGATION}}{{FONT_TOGGLE}}</header>{{INNER_BODY}}<div class="reading-layout"><main id="main" tabindex="-1"><article>{{BODY}}</article>{{PAGER}}<footer>Quantum Research Center · <a href="mailto:{{EMAIL}}">Contact</a></footer></main>{{LOCAL}}</div></div></body></html>