<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Website map | Quantum Research Center</title><meta name="description" content="Explore every page of Quantum Research Center as an interactive network of connected ideas."><link rel="canonical" href="{{CANONICAL}}"><link rel="icon" href="../icons/icon.svg"><script src="../education/computing/assets/theme.js"></script><script src="../navigation.js"></script><link rel="stylesheet" href="../styles.css"><link rel="stylesheet" href="../news/editorial.css"><link rel="stylesheet" href="graph.css"><script defer src="{{DATA_URL}}"></script><script defer src="graph.js"></script></head>
<body class="editorial graph-page"><a class="skip-link" href="#main">Skip to content</a><header class="toolbar editorial-header">{{LOGO}}{{NAV}}</header>
<main id="main" tabindex="-1"><div class="graph-heading"><div><p class="eyebrow">The connected library</p><h1>A map of the website.</h1><p>Every dot is a page. Every line is a link. Follow a connection somewhere new.</p></div><a href="../map/index.html">Explore the quantum topic map ↗</a></div>
<div class="graph-workspace"><aside class="graph-controls" aria-label="Graph controls"><label for="graph-search">Find a page</label><input id="graph-search" type="search" placeholder="Try entanglement or qubit…" autocomplete="off"><label for="graph-section">Explore a section</label><select id="graph-section"><option value="">All sections</option></select><div id="graph-legend" aria-label="Section colours"></div><label class="graph-check"><input type="checkbox" id="graph-menus"> Include menu links</label><label class="graph-check"><input type="checkbox" id="graph-local"> Selected page and neighbours</label><p id="graph-status" role="status">{{COUNT}} pages in the library</p><div id="graph-results" aria-label="Matching pages"></div><section class="graph-detail" aria-labelledby="detail-title"><p class="eyebrow">Follow a thread</p><h2 id="detail-title">Choose a page</h2><p id="detail-description">Select a dot to see its connections, or find a page above.</p><a id="graph-open" hidden>Open page ↗</a><ul id="graph-neighbours"></ul></section></aside>
<section class="graph-stage" aria-label="Interactive website graph"><canvas id="graph-canvas" tabindex="0" aria-label="Website graph. Use search and the page directory to select pages. Arrow keys pan, plus and minus zoom, and Home fits the graph, and Escape clears the selection."></canvas><div class="graph-tools"><button id="graph-zoom-in" aria-label="Zoom in">+</button><button id="graph-zoom-out" aria-label="Zoom out">−</button><button id="graph-fit">Fit graph</button><button id="graph-reset">Reset</button></div><span id="graph-tooltip" hidden></span><p class="graph-hint">Drag to explore · Scroll to zoom · Click empty space or press Escape to deselect</p><noscript><p>Use the complete page directory below to explore without JavaScript.</p></noscript></section></div>
<details class="graph-directory"><summary>Browse the page directory by section · {{COUNT}} pages</summary><ul>{{DIRECTORY}}</ul></details></main>
<footer class="graph-footer"><a href="../index.html">← Back to home</a><p>Content links are shown by default. Menu links are optional. Redirects and private build files are excluded.</p></footer></body></html>
